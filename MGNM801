section("5. DATA CLEANING")

# --- 5.1 TotalCharges: strip whitespace, coerce to numeric ---
df["TotalCharges"] = pd.to_numeric(df["TotalCharges"].astype(str).str.strip(), errors="coerce")
na_mask = df["TotalCharges"].isnull()
print(f"TotalCharges rows converted to NaN by coercion: {na_mask.sum()}")
print(f"Tenure values of the affected rows: {sorted(df.loc[na_mask, 'tenure'].unique().tolist())}")

# These are legitimate brand-new customers (tenure == 0) who have not yet
# been billed. They are NOT deleted (that would bias the 0-12 month tenure
# group and drop real customers). TotalCharges is transparently imputed as
# MonthlyCharges x tenure, which correctly evaluates to $0 for a zero-tenure
# customer - i.e. "no charges billed yet", not a guessed/fabricated amount.
df.loc[na_mask, "TotalCharges"] = df.loc[na_mask, "MonthlyCharges"] * df.loc[na_mask, "tenure"]
print(f"TotalCharges missing after documented imputation: {df['TotalCharges'].isnull().sum()}")

# --- 5.2 Duplicate rows / duplicate customer IDs ---
df = df.drop_duplicates()
df = df.drop_duplicates(subset="customerID")
print(f"Shape after defensive duplicate-drop (should be unchanged): {df.shape}")

# --- 5.3 Incorrect data types: SeniorCitizen (0/1 -> Yes/No), numeric flag kept ---
df["SeniorCitizenFlag"] = df["SeniorCitizen"]  # numeric 0/1 retained for reference only
df["SeniorCitizen"] = df["SeniorCitizen"].map({0: "No", 1: "Yes"})

