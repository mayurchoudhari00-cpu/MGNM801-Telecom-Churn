section("13. MODEL EVALUATION")


def evaluate(model, X_test, y_test, name):
    y_pred = model.predict(X_test)
    y_proba = model.predict_proba(X_test)[:, 1]
    metrics = {
        "Accuracy": accuracy_score(y_test, y_pred),
        "Precision": precision_score(y_test, y_pred),
        "Recall": recall_score(y_test, y_pred),
        "F1": f1_score(y_test, y_pred),
        "ROC_AUC": roc_auc_score(y_test, y_proba),
    }
    print(f"\n{name}:")
    for k, v in metrics.items():
        print(f"  {k}: {v:.4f}")
    return metrics, y_pred, y_proba


log_metrics, log_pred, log_proba = evaluate(log_reg, X_test, y_test, "Logistic Regression")
rf_metrics, rf_pred, rf_proba = evaluate(rf, X_test, y_test, "Random Forest")

print("""
Why recall matters here: the majority class (retained, ~73.5%) dominates the
data, so accuracy alone is a misleading metric - a model that always predicts
"retained" would score ~73.5% accuracy while catching zero churners. In a
retention context, a false negative (a real churner who is not flagged) means
a fully lost customer and their entire future recurring revenue, while a false
positive (a retained customer incorrectly flagged) only costs the modest price
of an unnecessary retention offer. Recall is therefore weighted most heavily
in champion-model selection, with F1 and ROC-AUC as supporting metrics.
""")

# Business-rule-based champion selection: prioritise recall
if rf_metrics["Recall"] > log_metrics["Recall"]:
    champion_name, champion_model = "Random Forest", rf
    champion_metrics, champion_pred, champion_proba = rf_metrics, rf_pred, rf_proba
else:
    champion_name, champion_model = "Logistic Regression", log_reg
    champion_metrics, champion_pred, champion_proba = log_metrics, log_pred, log_proba

print(f"CHAMPION MODEL (selected on recall, supported by F1/ROC-AUC): {champion_name}")

