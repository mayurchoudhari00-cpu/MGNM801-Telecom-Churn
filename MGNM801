rf_importances = rf.named_steps["model"].feature_importances_
assert len(feat_names_rf) == len(rf_importances)
importance_df = pd.DataFrame({"feature": feat_names_rf, "importance": rf_importances}) \
    .sort_values("importance", ascending=False).reset_index(drop=True)
print("Random Forest - top 10 feature importances:")
print(importance_df.head(10).to_string(index=False))

feat_names_log = get_feature_names(log_reg)
log_coefs = log_reg.named_steps["model"].coef_[0]
assert len(feat_names_log) == len(log_coefs)
