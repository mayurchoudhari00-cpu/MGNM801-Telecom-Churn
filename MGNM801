def churn_rate_table(dataframe, groupcol, order=None):
    g = dataframe.groupby(groupcol, observed=True).agg(
        Customers=("Churn_Flag", "size"), Churn_Rate=("Churn_Flag", "mean")
    )
    g["Churn_Rate_%"] = (g["Churn_Rate"] * 100).round(2)
    if order is not None:
        g = g.reindex(order)
    return g[["Customers", "Churn_Rate_%"]]


