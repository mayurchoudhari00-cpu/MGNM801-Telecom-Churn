# MonthlyChargeGroup - price band
def _charge_band(x):
    if x < 35:
        return "Low (<$35)"
    elif x < 70:
        return "Medium ($35-$70)"
    elif x < 100:
        return "High ($70-$100)"
    return "Premium ($100+)"

df["MonthlyChargeGroup"] = df["MonthlyCharges"].apply(_charge_band)

# Total_Services - count of all subscribed services (phone + internet + 6 add-ons)
df["Total_Services"] = (
    (df["PhoneService"] == "Yes").astype(int)
    + (df["InternetService"] != "No").astype(int)
